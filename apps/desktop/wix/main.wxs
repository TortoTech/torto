<!--
  The "cargo wix" subcommand provides a variety of predefined variables available
  for customization of this template. The values for each variable are set at
  installer creation time. The following variables are available:

  TargetTriple      = The rustc target triple name.
  TargetEnv         = The rustc target environment. This is typically either
                      "msvc" or "gnu" depending on the toolchain downloaded and
                      installed.
  TargetVendor      = The rustc target vendor. This is typically "pc", but Rust
                      does support other vendors, like "uwp".
  CargoTargetBinDir = The complete path to the directory containing the
                      binaries (exes) to include. The default would be
                      "target\release\". If an explicit rustc target triple is
                      used, i.e. cross-compiling, then the default path would
                      be "target\<CARGO_TARGET>\<CARGO_PROFILE>",
                      where "<CARGO_TARGET>" is replaced with the "CargoTarget"
                      variable value and "<CARGO_PROFILE>" is replaced with the
                      value from the "CargoProfile" variable. This can also
                      be overridden manually with the "target-bin-dir" flag.
  CargoTargetDir    = The path to the directory for the build artifacts, i.e.
                      "target".
  CargoProfile      = The cargo profile used to build the binaries
                      (usually "debug" or "release").
  Version           = The version for the installer. The default is the
                      "Major.Minor.Fix" semantic versioning number of the Rust
                      package.
-->

<!--
  Please do not remove these pre-processor If-Else blocks. These are used with
  the `cargo wix` subcommand to automatically determine the installation
  destination for 32-bit versus 64-bit installers. Removal of these lines will
  cause installation errors.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Torto'
        UpgradeCode='83A42DF6-BC2D-4904-8037-A11AB047015D'
        Manufacturer='TortoTech'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Torto native e-book reader'
            Manufacturer='TortoTech'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            MigrateFeatures='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <!-- Reuse the directory recorded by the previous version during both
             interactive and unattended major upgrades. A command-line
             APPLICATIONFOLDER supplied by the built-in updater remains the
             source of truth for the first upgrade from older installers. -->
        <Property Id='LEGACYAPPLICATIONFOLDER' Secure='yes'>
            <RegistrySearch
                Id='LegacyApplicationFolder'
                Root='HKLM'
                Key='Software\L-Chris\Torto'
                Name='InstallLocation'
                Type='raw'
                Win64='yes'/>
        </Property>
        <Property Id='APPLICATIONFOLDER' Secure='yes'>
            <RegistrySearch
                Id='PreviousApplicationFolder'
                Root='HKLM'
                Key='Software\TortoTech\Torto'
                Name='InstallLocation'
                Type='raw'
                Win64='yes'/>
        </Property>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Torto Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Torto'>
                    <!--
                      Disabling the license sidecar file in the installer is a two step process:

                      1. Comment out or remove the `Component` tag along with its contents.
                      2. Comment out or remove the `ComponentRef` tag with the "License" Id
                         attribute value further down in this file.
                    -->
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='apps\desktop\wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='torto.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\torto.exe'
                            KeyPath='yes'>
                            <Shortcut
                                Id='StartMenuShortcut'
                                Directory='ProgramMenuFolder'
                                Name='Torto'
                                Description='Torto e-book reader'
                                WorkingDirectory='APPLICATIONFOLDER'
                                Icon='ProductIcon.exe'
                                IconIndex='0'
                                Advertise='yes'/>
                        </File>
                    </Component>
                    <Component
                        Id='InstallLocationRegistry'
                        Guid='7FEC8F25-D476-4C0D-8B3A-A5CDF26A0456'
                        Win64='yes'>
                        <RegistryValue
                            Root='HKLM'
                            Key='Software\TortoTech\Torto'
                            Name='InstallLocation'
                            Type='string'
                            Value='[APPLICATIONFOLDER]'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='FileAssociations' Guid='*' Win64='yes'>
                        <RegistryValue
                            Root='HKLM'
                            Key='Software\RegisteredApplications'
                            Name='Torto'
                            Type='string'
                            Value='Software\TortoTech\Torto\Capabilities'
                            KeyPath='yes'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities' Name='ApplicationName' Type='string' Value='Torto'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities' Name='ApplicationDescription' Type='string' Value='Torto e-book reader'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.epub' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.mobi' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.azw' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.azw3' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.fb2' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.fbz' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.cbz' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.chm' Type='string' Value='Torto.Book'/>
                        <RegistryValue Root='HKLM' Key='Software\TortoTech\Torto\Capabilities\FileAssociations' Name='.pdf' Type='string' Value='Torto.Book'/>

                        <RegistryValue Root='HKCR' Key='Torto.Book' Type='string' Value='Torto e-book'/>
                        <RegistryValue Root='HKCR' Key='Torto.Book' Name='FriendlyTypeName' Type='string' Value='Torto e-book'/>
                        <RegistryValue Root='HKCR' Key='Torto.Book\DefaultIcon' Type='string' Value='[APPLICATIONFOLDER]torto.exe,0'/>
                        <RegistryValue Root='HKCR' Key='Torto.Book\shell\open\command' Type='string' Value='&quot;[APPLICATIONFOLDER]torto.exe&quot; &quot;%1&quot;'/>
                        <RegistryValue Root='HKCR' Key='.epub\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.mobi\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.azw\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.azw3\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.fb2\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.fbz\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.cbz\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.chm\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                        <RegistryValue Root='HKCR' Key='.pdf\OpenWithProgids' Name='Torto.Book' Type='string' Value=''/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'/>
            <!-- DesktopFolder is the Windows Installer standard directory.
                 Because this package is per-machine, MSI resolves it to the
                 shared desktop. CommonDesktopFolder is not a WiX 3 standard
                 directory and falls back to TARGETDIR (the install drive). -->
            <Directory Id='DesktopFolder'>
                <Component Id='DesktopShortcutComponent' Guid='*'>
                    <Shortcut
                        Id='DesktopShortcut'
                        Name='Torto'
                        Description='Torto e-book reader'
                        Target='[APPLICATIONFOLDER]torto.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='ProductIcon.exe'
                        IconIndex='0'/>
                    <RegistryValue
                        Root='HKCU'
                        Key='Software\TortoTech\Torto'
                        Name='DesktopShortcut'
                        Type='integer'
                        Value='1'
                        KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <!--
              Comment out or remove the following `ComponentRef` tag to remove
              the license sidecar file from the installer.
            -->
            <ComponentRef Id='License'/>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='InstallLocationRegistry'/>
            <Feature
                Id='DesktopShortcutFeature'
                Title='Desktop shortcut'
                Description='Creates a Torto shortcut on the desktop.'
                Level='1'
                Absent='allow'
                AllowAdvertise='no'>
                <ComponentRef Id='DesktopShortcutComponent'/>
            </Feature>
            <Feature
                Id='FileAssociationsFeature'
                Title='E-book file associations'
                Description='Makes Torto available in Open with for supported e-book files.'
                Level='1'
                Absent='allow'
                AllowAdvertise='no'>
                <ComponentRef Id='FileAssociations'/>
            </Feature>
        </Feature>

        <SetProperty Id='APPLICATIONFOLDER' Value='[LEGACYAPPLICATIONFOLDER]' After='AppSearch'>NOT APPLICATIONFOLDER AND LEGACYAPPLICATIONFOLDER</SetProperty>
        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>


        <!--
          Uncomment the following `Icon` and `Property` tags to change the product icon.

          The product icon is the graphic that appears in the Add/Remove
          Programs control panel for the application.
        -->
        <Icon Id='ProductIcon.exe' SourceFile='assets\windows\torto.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductIcon.exe'/>

        <Property Id='ARPHELPLINK' Value='https://github.com/TortoTech/torto'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <!--
              Disabling the EULA dialog in the installer is a two step process:

                 1. Uncomment the following two `Publish` tags
                 2. Comment out or remove the `<WiXVariable Id='WixUILicenseRtf'...` tag further down

            -->
            <!--<Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>-->
            <!--<Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>-->

        </UI>

        <!--
          Disabling the EULA dialog in the installer requires commenting out
          or removing the following `WixVariable` tag
        -->
        <WixVariable Id='WixUILicenseRtf' Value='apps\desktop\wix\License.rtf'/>


        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom banner image across
          the top of each screen. See the WiX Toolset documentation for details
          about customization.

          The banner BMP dimensions are 493 x 58 pixels.
        -->
        <WixVariable Id='WixUIBannerBmp' Value='assets\windows\installer\installer-banner.bmp'/>


        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom image to the first
          dialog, or screen. See the WiX Toolset documentation for details about
          customization.

          The dialog BMP dimensions are 493 x 312 pixels.
        -->
        <WixVariable Id='WixUIDialogBmp' Value='assets\windows\installer\installer-dialog.bmp'/>

    </Product>

</Wix>
